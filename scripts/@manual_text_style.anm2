@manual_kerning
--track@tracking:文字間隔,-200,200,0
--check@vertical:縦書き,false
--separator:カーニング値 / n行目 = 文字nと文字n+1の間隔(px)
--text@kern_values:カーニング値,

-- manual_kerning.anm2
-- 個別オブジェクトが有効かチェック
if obj.num == 0 or obj.num == nil then
    return
end

local cumulative = 0
local line_num = 0

for line in string.gmatch((kern_values or "") .. "\n", "([^\n]*)\n") do
    line_num = line_num + 1
    if line_num > obj.index then break end
    line = string.gsub(line, "\r", "")
    cumulative = cumulative + (tonumber(line) or 0)
end

if vertical then
    obj.oy = obj.oy + cumulative + tracking * obj.index
else
    obj.ox = obj.ox + cumulative + tracking * obj.index
end

@manual_font_size
--separator:フォントサイズ / n行目 = n文字目のサイズ(%)
--text@size_values:フォントサイズ,

if obj.num == 0 or obj.num == nil then
    return
end

local size_pct = 100
local line_num = 0

for line in string.gmatch((size_values or "") .. "\n", "([^\n]*)\n") do
    line_num = line_num + 1
    if line_num == obj.index + 1 then
        line = string.gsub(line, "\r", "")
        size_pct = tonumber(line) or 100
        break
    end
end

local s = size_pct / 100
local delta_oy = obj.h * obj.zoom / 2 * (1 - s)
obj.zoom = obj.zoom * s
obj.oy = obj.oy + delta_oy